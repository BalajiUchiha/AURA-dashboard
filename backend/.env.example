# ── Supabase ──────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── OpenChargeMap ─────────────────────────────────────
OPENCHARGEMAP_API_KEY=your-openchargemap-api-key

# ── Google Gemini ─────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ── ElevenLabs TTS (optional — frontend falls back to text-only) ──
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=pMsXgVXv3BLzUgSXRplE

# ── Fixed GPS coordinates (used until GPS sensor is wired in) ──
FIXED_LAT=13.0827
FIXED_LON=80.2707

# ── MQTT Broker (HiveMQ Cloud) ───────────────────────
MQTT_BROKER_HOST=your-cluster-id.ala.us-east-1.emqxp.com
MQTT_BROKER_PORT=8883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
MQTT_TOPIC=aura/vehicle/data

# ── Optional overrides ───────────────────────────────
# POLL_INTERVAL_S=5
HISTORY_WINDOW=10
LOW_RANGE_THRESHOLD_KM=2.0
JARVIS_MIN_CALL_INTERVAL_SECONDS=30
